# Copy this file to sinitek.yaml and adjust local default values.
# Keep credentials in environment variables, not in this file.

# CLI 默认打开的估值模型文件。
# A 股：./Sinitek_Model_Ashare_V12.xlsx（ModelType=0）
# 港股：./Sinitek_Model_HK_V4.xlsx       （ModelType=1）
# 模板与目标股票板块必须一致；命令行 -Workbook 会覆盖此项。
workbook: ./Sinitek_Model_Ashare_V12.xlsx

# 未传 -OutWorkbook 时，自动生成产物文件的输出目录。
output_dir: ./output

# 登录凭据配置；这里只写环境变量名，不直接保存账号密码。
auth:
  # 保存携宁云用户名或邮箱的环境变量名。
  username_env: SINITEK_USERNAME

  # 保存携宁云密码的环境变量名。
  password_env: SINITEK_PASSWORD

# CLI 参数默认值；命令行显式传参会覆盖这些配置。
defaults:
  # 历史数据年数：对应插件更新窗口的“历史数据年数”。
  # CLI 会同步写入“目录”页 D3 和 HistoryYear 自定义属性，影响更新时提取的历史年度数据范围。
  history_year: 4

  # 预测数据年数：对应插件更新窗口的“预测数据年数”。
  # CLI 会同步写入“目录”页 D4 和 ForecastYear 自定义属性；“目录”页 D7 会通过公式 IF(D4>10,10,D4) 自动更新。
  forecast_year: 3

  # 报表货币显示单位倍率；CLI 会同步写入“目录”页 D5/D6，从而影响报表单位。
  # 当前默认是百万元。
  # 映射关系：元=1，千元=0.001，万元=0.0001，百万元=0.000001，亿元=0.00000001。
  currency_unit: "0.000001"

  # update/produce 是否更新目录页。
  update_directory: true

  # update/produce 是否更新财务源数据、附注、经营数据和可比分析。
  update_src_data: true

  # 最新年报年份变化时，是否迁移历史预测数据。
  migrate: false

  # update 是否顺带生成 output sheet；produce 会忽略此项并始终生成 output sheet。
  add_output: false

  # 公司经营数据口径：传给插件 CompanyManagementType，用于更新“公司经营数据”表。
  # 映射关系：1=按行业，2=按产品，3=按地区。当前默认 "2" 即按产品。
  segment_dimension: "product"

  # 可比公司 GSDM 列表，逗号分隔。留空时 CLI 会复刻插件逻辑：
  # 同一主公司复用模型现有 PeerStock；切换主公司时从携宁云接口自动获取推荐可比公司。
  peer_stock: ""

  # predict action 的批量应用范围：all/sales/capital/investment/assume。
  # 留空或 all 表示当前预测设置表单内所有指标。
  # 注意：以下 prediction_* 字段当前的指标行号映射仅按 A 股模板校准；
  # 港股模板（Sinitek_Model_HK_V4.xlsx）需通过 prediction_settings 直接传底层控件名才能命中。
  prediction_scope: "all"

  # predict action 的批量应用行号，逗号分隔；留空表示所选范围内全部行。
  prediction_rows: ""

  # predict action 的批量应用指标名，逗号/分号分隔；可与 prediction_scope 一起限定范围。
  # 示例：研发费用率,所得税税率,应收账款周转天数。
  prediction_indicators: ""

  # predict action 的批量方法。留空时需通过命令行传 -PredictionMethod 或 -PredictionSettings。
  # 可选值：latest1、avg2、avg3、weighted2、weighted3、custom、zero，或插件下拉框索引 0-6。
  prediction_method: ""

  # predict action 的精确设置，逗号/分号分隔，例如：
  # 研发费用率=avg3,所得税税率=weighted2,应收账款周转天数=zero
  prediction_settings: ""

  # CLI 单次执行的总超时秒数。默认 300 秒；设为 0 可关闭总超时监督。
  timeout_seconds: 300
